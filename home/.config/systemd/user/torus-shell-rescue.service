[Unit]
Description=torus shell rescue: keep a locked session locked when the shell gives up

[Service]
Type=oneshot
ExecStart=/bin/sh -c '[ -e "$XDG_RUNTIME_DIR/torus-lock/locked" ] || exit 0; sleep 4; systemctl --user is-active --quiet torus-shell.service && exit 0; pidof hyprlock > /dev/null || exec hyprlock'
