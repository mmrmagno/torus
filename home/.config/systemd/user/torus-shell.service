[Unit]
Description=torus shell (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/bin/sh -c 'export HYPRLAND_INSTANCE_SIGNATURE="$${HYPRLAND_INSTANCE_SIGNATURE:-$$(ls -t "$XDG_RUNTIME_DIR/hypr" | head -1)}" WAYLAND_DISPLAY="$${WAYLAND_DISPLAY:-wayland-1}"; exec /usr/bin/qs -c torus'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
