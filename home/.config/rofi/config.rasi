configuration {
    modi: "drun,window,run";
    show-icons: true;
    icon-theme: "Tela-circle-dracula";
    font: "Inter 12";
    drun-display-format: "{name}";
    display-drun: "";
    display-window: "";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}
@import "~/.local/state/torus/theme/rofi-config.rasi"
@theme "~/.config/rofi/themes/marc-os.rasi"
