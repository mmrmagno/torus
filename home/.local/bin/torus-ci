#!/usr/bin/env bash
set -uo pipefail
dir=${1:-$PWD}
cd "$dir" 2> /dev/null || exit 0
command -v gh > /dev/null || exit 0
sha=$(git rev-parse HEAD 2> /dev/null) || exit 0
repo=$(timeout 15 gh repo view --json nameWithOwner -q .nameWithOwner 2> /dev/null) || exit 0
[[ -n $repo ]] || exit 0
lock=${XDG_RUNTIME_DIR:-/tmp}/torus-ci-$sha
mkdir "$lock" 2> /dev/null || exit 0
trap 'rmdir "$lock" 2> /dev/null' EXIT
wait_s=${TORUS_CI_WAIT:-90}
id=""
for _ in $(seq $((wait_s / 5))); do
  id=$(timeout 15 gh run list -R "$repo" --commit "$sha" -L 1 --json databaseId -q '.[0].databaseId' 2> /dev/null)
  [[ -n $id ]] && break
  sleep 5
done
[[ -n $id ]] || exit 0
timeout "${TORUS_CI_MAX:-3600}" gh run watch -R "$repo" "$id" -i "${TORUS_CI_INTERVAL:-15}" > /dev/null 2>&1
read -r conclusion name url < <(timeout 15 gh run view -R "$repo" "$id" --json conclusion,workflowName,url -q '"\(.conclusion) \(.workflowName | gsub(" "; "_")) \(.url)"' 2> /dev/null)
[[ -n ${conclusion:-} ]] || exit 0
name=${name//_/ }
short=${repo#*/}
case $conclusion in
  success) icon=emblem-ok-symbolic title="CI passed · $short" ;;
  cancelled | skipped) icon=dialog-information title="CI $conclusion · $short" ;;
  *) icon=dialog-error title="CI failed · $short" ;;
esac
a=$(notify-send -a "GitHub Actions" -i "$icon" -A open=Open "$title" "$name on $(git rev-parse --abbrev-ref HEAD 2> /dev/null)")
[[ $a == open ]] && xdg-open "$url"
exit 0
