#!/usr/bin/env bash
set -euo pipefail

dir=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots
mkdir -p "$dir"
file=$dir/torus-$(date +%Y%m%d-%H%M%S).png
[[ -e $file ]] && file=${file%.png}-$$.png

focused() {
  hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'
}

picker=
cleanup() {
  if [[ -n $picker ]]; then kill "$picker" 2> /dev/null || true; fi
}
trap cleanup EXIT

if [[ ${1:-s} == s || ${1:-s} == sf || ${1:-s} == sc ]]; then
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/torus-shot.lock"
  flock -n 9 || exit 0
fi

picker_mapped() {
  local _
  for _ in $(seq 20); do
    hyprctl layers -j 2> /dev/null | jq -e '[.. | objects | select(.namespace? == "hyprpicker")] | length > 0' > /dev/null && return 0
    sleep 0.05
  done
}

windows() {
  { hyprctl monitors -j; hyprctl clients -j; } 2> /dev/null | jq -rs '
    (.[0] // []) as $mons
    | [$mons[] | .activeWorkspace.id, .specialWorkspace.id | select(. != null)] as $ws
    | [(.[1] // [])[] | select(.mapped and (.hidden | not) and .class != "org.quickshell")
        | select(.workspace.id as $w | any($ws[]; . == $w))] as $cs
    | [$cs[] | select(.fullscreen > 0) | .workspace.id] as $full
    | $cs[] | select(.fullscreen > 0 or (.workspace.id as $w | any($full[]; . == $w) | not))
    | . as $c | first($mons[] | select(.id == $c.monitor)) as $m
    | ($m | if .transform % 2 == 1 then [.height, .width] else [.width, .height] end | map(. / $m.scale)) as [$mw, $mh]
    | [([$c.at[0], $m.x] | max), ([$c.at[1], $m.y] | max),
       ([$c.at[0] + $c.size[0], $m.x + $mw] | min), ([$c.at[1] + $c.size[1], $m.y + $mh] | min)]
    | select(.[2] > .[0] and .[3] > .[1])
    | "\(.[0] | floor),\(.[1] | floor) \(.[2] - .[0] | floor)x\(.[3] - .[1] | floor) \($c.address)"
  ' 2> /dev/null || true
}

pick() {
  windows | slurp -d -c b4befeff -w 2 -B b4befe40
}

case ${1:-s} in
  s)
    geo=$(pick) || exit 0
    grim -g "$geo" "$file"
    ;;
  sf)
    hyprpicker -r -z &
    picker=$!
    picker_mapped || true
    geo=$(pick) || exit 0
    grim -g "$geo" "$file"
    cleanup
    picker=
    ;;
  m)
    grim -o "$(focused)" "$file"
    ;;
  p)
    grim "$file"
    ;;
  sc)
    "$(dirname "$(readlink -f "$0")")"/torus-ocr --region || true
    exit 0
    ;;
  *)
    echo "usage: torus-shot s|sf|m|p|sc" >&2
    exit 2
    ;;
esac
exec 9>&-
[[ -f $file ]] && wl-copy < "$file"
[[ -f $file ]] && { "$(dirname "$(readlink -f "$0")")"/torus-sound play shot || true; }
if ! qs -c torus ipc call torus screenshotShow "$file" > /dev/null 2>&1; then
  satty --filename "$file" --output-filename "$file" --early-exit --copy-command wl-copy &
fi
