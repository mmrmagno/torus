#!/usr/bin/env bash
set -euo pipefail

dir=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots
mkdir -p "$dir"
file=$dir/torus-$(date +%Y%m%d-%H%M%S).png

focused() {
  hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'
}

picker=
cleanup() {
  if [[ -n $picker ]]; then kill "$picker" 2> /dev/null || true; fi
}
trap cleanup EXIT

if [[ ${1:-s} == s || ${1:-s} == sf || ${1:-s} == sc ]]; then
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/torus-shot.lock"
  flock -n 9 || exit 0
fi

picker_mapped() {
  local _
  for _ in $(seq 20); do
    hyprctl layers -j 2> /dev/null | jq -e '[.. | objects | select(.namespace? == "hyprpicker")] | length > 0' > /dev/null && return 0
    sleep 0.05
  done
}

case ${1:-s} in
  s)
    geo=$(slurp -d) || exit 0
    grim -g "$geo" "$file"
    ;;
  sf)
    hyprpicker -r -z &
    picker=$!
    picker_mapped || true
    geo=$(slurp -d) || exit 0
    grim -g "$geo" "$file"
    cleanup
    picker=
    ;;
  m)
    grim -o "$(focused)" "$file"
    ;;
  p)
    grim "$file"
    ;;
  sc)
    "$(dirname "$(readlink -f "$0")")"/torus-ocr --region || true
    exit 0
    ;;
  *)
    echo "usage: torus-shot s|sf|m|p|sc" >&2
    exit 2
    ;;
esac
[[ -f $file ]] && wl-copy < "$file"
if ! qs -c torus ipc call torus screenshotShow "$file" > /dev/null 2>&1; then
  satty --filename "$file" --output-filename "$file" --early-exit --copy-command wl-copy &
fi
