#!/usr/bin/env bash
set -uo pipefail

log=${TORUS_PACMAN_LOG:-/var/log/pacman.log}

case ${1:-list} in
  list)
    checkupdates 2> /dev/null | awk '$3 == "->" {printf "repo\t%s\t%s\t%s\n", $1, $2, $4}'
    yay -Qua 2> /dev/null | awk '$3 == "->" {printf "aur\t%s\t%s\t%s\n", $1, $2, $4}'
    ;;
  news)
    n=${2:-6}
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/torus/arch-news.tsv
    last=$(grep -a 'starting full system upgrade' "$log" 2> /dev/null | tail -n 1 | sed -n 's/^\[\([^]]*\)\].*/\1/p')
    lastsec=$(date -d "${last:-1970-01-01}" +%s 2> /dev/null || echo 0)
    age=$(($(date +%s) - $(stat -c %Y "$cache" 2> /dev/null || echo 0)))
    if ((age > ${TORUS_NEWS_TTL:-3600})); then
      fresh=$(curl -sfL --max-time 10 "${TORUS_NEWS_URL:-https://archlinux.org/feeds/news/}" | tr -d '\n' | awk 'BEGIN { RS = "<item>" } NR > 1 && NR <= 21 {
        t = $0; sub(/.*<title>/, "", t); sub(/<\/title>.*/, "", t)
        l = $0; sub(/.*<link>/, "", l); sub(/<\/link>.*/, "", l)
        d = $0; sub(/.*<pubDate>/, "", d); sub(/<\/pubDate>.*/, "", d)
        gsub(/&amp;/, "\\&", t); gsub(/&lt;/, "<", t); gsub(/&gt;/, ">", t); gsub(/&quot;/, "\"", t); gsub(/&#39;/, "\x27", t)
        print d "\t" t "\t" l
      }')
      if [[ -n $fresh ]]; then
        mkdir -p "$(dirname "$cache")"
        printf '%s\n' "$fresh" > "$cache"
      else
        [[ -f $cache ]] && touch -d "-$((${TORUS_NEWS_TTL:-3600} - 600)) seconds" "$cache"
      fi
    fi
    [[ -f $cache ]] || exit 0
    head -n "$n" "$cache" | while IFS=$'\t' read -r pub title link; do
      s=$(date -d "$pub" +%s 2> /dev/null || echo 0)
      ((s > lastsec)) && state=new || state=seen
      printf '%s\t%s\t%s\t%s\n' "$state" "$(date -d "$pub" +%F 2> /dev/null)" "$title" "$link"
    done
    ;;
  *)
    echo "usage: torus-updates list | news [N]" >&2
    exit 2
    ;;
esac
