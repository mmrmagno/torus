#!/usr/bin/env bash
set -uo pipefail

log=${TORUS_PACMAN_LOG:-/var/log/pacman.log}

case ${1:-list} in
  list)
    checkupdates 2> /dev/null | awk '$3 == "->" {printf "repo\t%s\t%s\t%s\n", $1, $2, $4}'
    yay -Qua 2> /dev/null | awk '$3 == "->" {printf "aur\t%s\t%s\t%s\n", $1, $2, $4}'
    ;;
  news)
    n=${2:-6}
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/torus/arch-news.tsv
    last=$(grep -a 'starting full system upgrade' "$log" 2> /dev/null | tail -n 1 | sed -n 's/^\[\([^]]*\)\].*/\1/p')
    lastsec=$(date -d "${last:-1970-01-01}" +%s 2> /dev/null || echo 0)
    age=$(($(date +%s) - $(stat -c %Y "$cache" 2> /dev/null || echo 0)))
    if ((age > ${TORUS_NEWS_TTL:-3600})); then
      fresh=$(curl -sfL --max-time 10 "${TORUS_NEWS_URL:-https://archlinux.org/feeds/news/}" | tr -d '\n' | awk 'BEGIN { RS = "<item>" } NR > 1 && NR <= 21 {
        t = $0; sub(/.*<title>/, "", t); sub(/<\/title>.*/, "", t)
        l = $0; sub(/.*<link>/, "", l); sub(/<\/link>.*/, "", l)
        d = $0; sub(/.*<pubDate>/, "", d); sub(/<\/pubDate>.*/, "", d)
        gsub(/&amp;/, "\\&", t); gsub(/&lt;/, "<", t); gsub(/&gt;/, ">", t); gsub(/&quot;/, "\"", t); gsub(/&#39;/, "\x27", t)
        print d "\t" t "\t" l
      }')
      if [[ -n $fresh ]]; then
        mkdir -p "$(dirname "$cache")"
        printf '%s\n' "$fresh" > "$cache"
      else
        [[ -f $cache ]] && touch -d "-$((${TORUS_NEWS_TTL:-3600} - 600)) seconds" "$cache"
      fi
    fi
    [[ -f $cache ]] || exit 0
    head -n "$n" "$cache" | while IFS=$'\t' read -r pub title link; do
      s=$(date -d "$pub" +%s 2> /dev/null || echo 0)
      ((s > lastsec)) && state=new || state=seen
      printf '%s\t%s\t%s\t%s\n' "$state" "$(date -d "$pub" +%F 2> /dev/null)" "$title" "$link"
    done
    ;;
  torus)
    "$(dirname "$(readlink -f "$0")")/torus-update" --list | head -n "$((${2:-20} + 1))"
    ;;
  upgrade)
    island() { qs -c torus ipc call torus islandFlash notification "$1" > /dev/null 2>&1 || notify-send -a torus "Update" "$1"; }
    mapfile -t fresh < <("$0" news 10 | awk -F'\t' '$1 == "new"')
    if ((${#fresh[@]})); then
      echo "Arch posted news since your last full upgrade:"
      for l in "${fresh[@]}"; do IFS=$'\t' read -r _ day title link <<< "$l"; printf '  %s  %s\n      %s\n' "$day" "$title" "$link"; done
      while :; do
        read -r -p "Read it first? o opens them in the browser, y updates anyway, anything else stops: " a || a=n
        case $a in
          o | O) for l in "${fresh[@]}"; do IFS=$'\t' read -r _ _ _ link <<< "$l"; torus-launch xdg-open "$link" > /dev/null 2>&1; done ;;
          y | Y) break ;;
          *) echo "stopped, nothing changed"; island "Update stopped: read the Arch news first"; exit 3 ;;
        esac
      done
    fi
    if ! yay -Syu; then
      island "Update failed, see the terminal"
      exit 1
    fi
    echo
    echo "torus doctor:"
    torus-doctor
    fails=$?
    if ((fails == 0)); then island "Update done · torus doctor: all green"; else island "Update done · torus doctor found $fails problem$( ((fails == 1)) || echo s), run torus doctor"; fi
    exit "$fails"
    ;;
  *)
    echo "usage: torus-updates list | news [N] | torus [N] | upgrade" >&2
    exit 2
    ;;
esac
