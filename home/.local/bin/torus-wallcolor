#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys

ACCENTS = ["rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach", "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender"]


def lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def oklab(rgb):
    r, g, b = (lin(x / 255) for x in rgb)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s)


def hexrgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def main():
    if len(sys.argv) < 2:
        print("usage: torus-wallcolor IMAGE [PALETTE_JSON]", file=sys.stderr)
        return 2
    state = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
    pal_path = sys.argv[2] if len(sys.argv) > 2 else os.path.join(state, "torus", "theme", "qs-colors.json")
    with open(pal_path) as f:
        pal = json.load(f)
    try:
        out = subprocess.run(["magick", sys.argv[1], "-resize", "96x96", "-colors", "12", "-depth", "8", "-format", "%c", "histogram:info:-"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return 1
    best, score = None, -1.0
    for line in out.splitlines():
        m = re.match(r"\s*(\d+):.*#([0-9A-Fa-f]{6})", line)
        if not m:
            continue
        count, rgb = int(m.group(1)), hexrgb(m.group(2))
        L, a, b = oklab(rgb)
        chroma = (a * a + b * b) ** 0.5
        s = count * (chroma ** 1.5) * (1 if 0.25 < L < 0.92 else 0.2)
        if s > score:
            best, score = (L, a, b), s
    if best is None:
        return 1
    L0, a0, b0 = best
    name = min((n for n in ACCENTS if n in pal), key=lambda n: sum((x - y) ** 2 for x, y in zip((L0 * 0.5, a0, b0), (lambda c: (c[0] * 0.5, c[1], c[2]))(oklab(hexrgb(pal[n]))))))
    print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
