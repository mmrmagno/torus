#!/usr/bin/env bash
set -uo pipefail
fmt='{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'

engines() {
  local e
  for e in docker podman; do
    command -v "$e" > /dev/null && timeout 5 "$e" ps -q > /dev/null 2>&1 && echo "$e"
  done
}

case ${1:-list} in
  list)
    for e in $(engines); do
      timeout 5 "$e" ps --format "$fmt" 2> /dev/null | awk -v e="$e" -F'\t' -v OFS='\t' 'NF >= 4 { print e, $1, $2, $3, $4, $5 }'
    done
    ;;
  logs | restart | stop)
    e=${2:-}; id=${3:-}
    [[ $e == docker || $e == podman ]] && [[ $id =~ ^[0-9a-zA-Z_.-]+$ ]] || { echo "usage: torus-containers $1 docker|podman ID" >&2; exit 2; }
    if [[ $1 == logs ]]; then exec "$e" logs -f --tail 200 "$id"; fi
    timeout 60 "$e" "$1" "$id" > /dev/null
    ;;
  *) echo "usage: torus-containers list|logs|restart|stop" >&2; exit 2 ;;
esac
