#!/usr/bin/env bash
set -uo pipefail
fmt='{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'

engines() {
  local e
  for e in docker podman; do
    command -v "$e" > /dev/null && timeout 5 "$e" ps -q > /dev/null 2>&1 && echo "$e"
  done
}

case ${1:-list} in
  list)
    for e in $(engines); do
      p='{{.Label "com.docker.compose.project"}}'
      timeout 5 "$e" ps --format "$fmt\t$p" 2> /dev/null | awk -v e="$e" -F'\t' -v OFS='\t' 'NF >= 4 { p = $6; if (p == "<no value>") p = ""; print e, $1, $2, $3, $4, $5, p }'
    done
    ;;
  logs | restart | stop)
    e=${2:-}; id=${3:-}
    [[ $e == docker || $e == podman ]] && [[ $id =~ ^[0-9a-zA-Z_.-]+$ ]] || { echo "usage: torus-containers $1 docker|podman ID" >&2; exit 2; }
    if [[ $1 == logs ]]; then exec "$e" logs -f --tail 200 "$id"; fi
    timeout 60 "$e" "$1" "$id" > /dev/null
    ;;
  restart-project)
    e=${2:-}; p=${3:-}
    [[ $e == docker || $e == podman ]] && [[ $p =~ ^[0-9a-zA-Z_.-]+$ ]] || { echo "usage: torus-containers restart-project docker|podman PROJECT" >&2; exit 2; }
    ids=$(timeout 10 "$e" ps -q --filter "label=com.docker.compose.project=$p")
    [[ -n $ids ]] || exit 1
    timeout 120 "$e" restart $ids > /dev/null
    ;;
  *) echo "usage: torus-containers list|logs|restart|stop|restart-project" >&2; exit 2 ;;
esac
