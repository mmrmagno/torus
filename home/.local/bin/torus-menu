#!/usr/bin/env bash
set -euo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}/torus
data=$HOME/.local/share/torus
style=$(cat "$state/rofi-style" 2> /dev/null || echo marc-os)
theme=$HOME/.config/rofi/themes/$style.rasi
styles=(marc-os compact grid)

menu() {
  rofi -dmenu -i -p "$1" -theme "$theme" "${@:2}"
}

if pgrep -x rofi > /dev/null; then
  pkill -x rofi
  exit 0
fi

case ${1:-drun} in
  drun) exec rofi -show drun -show-icons -theme "$theme" ;;
  window) exec rofi -show window -show-icons -theme "$theme" ;;
  files)
    pick=$(cd "$HOME" && {
      if command -v fd > /dev/null; then
        fd --type f --max-depth 8 --color never . 2> /dev/null
      else
        find . -mindepth 1 -maxdepth 4 -name '.*' -prune -o -type f -print 2> /dev/null | sed 's|^\./||'
      fi
    } | menu "files" -async-pre-read 64) || exit 0
    [[ -n $pick ]] && xdg-open "$HOME/$pick"
    ;;
  emoji)
    pick=$(menu "emoji" < "$data/emoji.db") || exit 0
    [[ -n $pick ]] && printf '%s' "${pick%% *}" | wl-copy
    ;;
  glyph)
    pick=$(menu "glyph" < "$data/glyph.db") || exit 0
    [[ -n $pick ]] && printf '%s' "$(cut -f1 <<< "$pick")" | wl-copy
    ;;
  calc)
    expr=$(menu "calc" < /dev/null) || exit 0
    [[ -n $expr ]] || exit 0
    result=$(qalc -t "$expr")
    printf '%s' "$result" | wl-copy
    notify-send -a torus "$expr" "= $result (copied)"
    ;;
  websearch)
    engines=$(sed 's/^ *\([^|]*\)| *\([^|]*\) |.*/\1 \2/' "$data/websearch.lst")
    engine=$(menu "search with" <<< "$engines") || exit 0
    [[ -n $engine ]] || exit 0
    name=${engine##* }
    url=$(grep -F "| $name |" "$data/websearch.lst" | head -1 | awk -F'| ' '{print $NF}')
    query=$(menu "$name" < /dev/null) || exit 0
    [[ -n $query ]] && xdg-open "${url//%s/$(jq -rn --arg q "$query" '$q | @uri')}"
    ;;
  clipboard)
    pick=$(cliphist list | menu "clipboard") || exit 0
    [[ -n $pick ]] && cliphist decode <<< "$pick" | wl-copy
    ;;
  clipmanager)
    action=$(printf 'delete an item\nwipe history\n' | menu "clipboard manager") || exit 0
    case $action in
      "delete an item") pick=$(cliphist list | menu "delete") && cliphist delete <<< "$pick" ;;
      "wipe history") cliphist wipe && notify-send -a torus "Clipboard" "history wiped" ;;
    esac
    ;;
  hyprlock)
    pick=$(printf 'torus\nmarc-os\nsf_marc\n' | menu "lock screen") || exit 0
    [[ -n $pick ]] && "$(dirname "$(readlink -f "$0")")/torus-lockstyle" "$pick"
    ;;
  *)
    echo "usage: torus-menu drun|window|files|emoji|glyph|calc|websearch|clipboard|clipmanager|hyprlock" >&2
    exit 2
    ;;
esac
