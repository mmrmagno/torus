#!/usr/bin/env bash
set -euo pipefail

(($# == 4)) || { echo "usage: torus-lyrics artist title album seconds" >&2; exit 1; }
dir=${XDG_CACHE_HOME:-$HOME/.cache}/torus/lyrics
key=$(printf '%s\n' "$@" | sha1sum | cut -c1-16)
file=$dir/$key.lrc

if [[ -f $file ]]; then
  cat "$file"
  exit 0
fi

rc=0
json=$(curl -sf --max-time 8 -G "https://lrclib.net/api/get" \
  --data-urlencode "artist_name=$1" \
  --data-urlencode "track_name=$2" \
  --data-urlencode "album_name=$3" \
  --data-urlencode "duration=$4") || rc=$?

mkdir -p "$dir"
if ((rc == 22)); then
  : > "$file"
  exit 0
fi
((rc == 0)) || exit 0
lyrics=$(jq -r '.syncedLyrics // empty' <<< "$json")
printf '%s' "$lyrics" > "$file"
[[ -n $lyrics ]] && printf '%s\n' "$lyrics"
exit 0
