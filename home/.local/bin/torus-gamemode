#!/usr/bin/env bash
set -euo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}/torus
mkdir -p "$state"
current=$(cat "$state/gamemode" 2> /dev/null || echo off)

on() {
  echo "$1" > "$state/gamemode"
  hyprctl eval 'torus_gamemode_apply()' > /dev/null
  qs -c torus ipc call torus gamemode true > /dev/null 2>&1 || true
}

off() {
  echo off > "$state/gamemode"
  "$(dirname "$(readlink -f "$0")")"/torus-reload || true
  qs -c torus ipc call torus gamemode false > /dev/null 2>&1 || true
}

case ${1:-toggle} in
  toggle)
    if [[ $current == off ]]; then
      on on
      notify-send -a torus -u low "Game mode" "on: effects off, donut paused, only critical notifications"
    else
      off
      notify-send -a torus -u low "Game mode" "off"
    fi
    ;;
  auto-on) [[ $current == off ]] && on auto ;;
  auto-off) [[ $current == auto ]] && off ;;
  status) echo "$current" ;;
  *) echo "usage: torus-gamemode [toggle|auto-on|auto-off|status]" >&2; exit 2 ;;
esac
exit 0
