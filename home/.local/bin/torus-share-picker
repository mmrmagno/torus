#!/usr/bin/env python3
import os
import sys
import time

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "torus")
TARGET = os.path.join(STATE, "share-target")


def wanted():
    try:
        if time.time() - os.stat(TARGET).st_mtime > 20:
            return ""
        return open(TARGET).read().strip()
    except OSError:
        return ""


def windows():
    for entry in os.environ.get("XDPH_WINDOW_SHARING_LIST", "").split("[HA>]"):
        if "[HC>]" not in entry:
            continue
        handle, rest = entry.split("[HC>]", 1)
        yield handle.strip(), rest.split("[HT>]", 1)[0]


want = wanted()
if want:
    for handle, cls in windows():
        if cls == want:
            try:
                os.remove(TARGET)
            except OSError:
                pass
            print("[SELECTION]/window:" + handle, flush=True)
            sys.exit(0)
os.execvp(os.environ.get("TORUS_SHARE_FALLBACK", "hyprland-share-picker"), ["hyprland-share-picker"] + sys.argv[1:])
