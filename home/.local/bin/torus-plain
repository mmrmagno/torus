#!/usr/bin/env bash
set -uo pipefail

exec perl -CSD -0777 -pe '
  s/\r\n?/\n/g;
  tr/\x{2018}\x{2019}\x{201A}\x{201B}/\x27/;
  tr/\x{201C}\x{201D}\x{201E}\x{201F}/"/;
  tr/\x{00A0}\x{2007}\x{202F}/ /;
  s/[\x{200B}\x{200C}\x{2060}\x{FEFF}]//g;
  s/\x{200D}(?!\p{Extended_Pictographic})//g;
  s/[ \t]+$//mg;
  s/\A(?:[ \t]*\n)+//;
  s/\s+\z//;
  if (/\A([ \t]+)/) {
    my $ind = $1;
    my $block = /\n/;
    for my $l (split /\n/) { next if $l =~ /^\s*$/; $block = 0, last if index($l, $ind) != 0 }
    s/\A[ \t]+// unless $block;
  }
'
