#!/usr/bin/env bash
set -euo pipefail

SELF=$(readlink -f "$0")
REPO=$(cd "$(dirname "$SELF")/../../.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/torus
ACCENTS=(rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire blue lavender)
FLAVOURS=(mocha macchiato frappe latte)

warn() { echo "torus: $*" >&2; }

current_accent() {
  cat "$STATE/accent" 2>/dev/null || echo mauve
}

current_flavour() {
  local f
  f=$(cat "$STATE/flavour" 2>/dev/null || true)
  [[ " ${FLAVOURS[*]} " == *" $f "* ]] && echo "$f" || echo mocha
}

tela_of() {
  case $1 in
    rosewater | flamingo | pink) echo pink ;;
    mauve) echo purple ;;
    red | maroon) echo red ;;
    peach) echo orange ;;
    yellow) echo yellow ;;
    green) echo green ;;
    teal) echo manjaro ;;
    sky | sapphire | blue) echo blue ;;
    *) echo dracula ;;
  esac
}

flavour_meta() {
  ICON_THEME=Tela-circle-$(tela_of "${2:-$(current_accent)}")
  if [[ $1 == latte ]]; then
    DARK=false GTK_THEME=adw-gtk3 COLOR_SCHEME=prefer-light
  else
    DARK=true GTK_THEME=adw-gtk3-dark COLOR_SCHEME=prefer-dark
  fi
}

sed_script() {
  local accent=$1 flavour=$2
  flavour_meta "$flavour" "$accent"
  jq -r --arg a "$accent" --arg f "$flavour" --arg dark "$DARK" --arg gtk "$GTK_THEME" --arg scheme "$COLOR_SCHEME" --arg icons "$ICON_THEME" '
    def h2d: ascii_downcase | explode | map(if . >= 97 then . - 87 else . - 48 end) | reduce .[] as $d (0; . * 16 + $d);
    def d2h: [(. / 16 | floor), (. % 16)] | map(if . < 10 then . + 48 else . + 87 end) | implode;
    def rgb: .[1:] | [.[0:2], .[2:4], .[4:6]] | map(h2d);
    def mix($b; $t): [(rgb), ($b | rgb)] | transpose | map(.[1] + (.[0] - .[1]) * $t | floor | d2h) | "#" + add;
    . as $p | ($dark == "true") as $d | $p[$a] as $acc
    | (if $d then $p.crust else $p.text end) as $shadow
    | (to_entries | map({key, value})) + [
        {key: "accent", value: $acc},
        {key: "accent_hover", value: (if $d then ("#000000" | mix($acc; 0.08)) else ("#ffffff" | mix($acc; 0.085)) end)},
        {key: "shadow", value: $shadow},
        {key: "diff_minus", value: ($p.red | mix($p.base; 0.25))},
        {key: "diff_plus", value: ($p.green | mix($p.base; 0.2))},
        {key: "term0", value: (if $d then $p.surface1 else $p.subtext1 end)},
        {key: "term8", value: (if $d then $p.surface2 else $p.subtext0 end)},
        {key: "term7", value: (if $d then $p.subtext1 else $p.surface2 end)},
        {key: "term15", value: (if $d then $p.subtext0 else $p.surface1 end)}
      ]
    | (.[] | "s/@\(.key)_rgb@/\(.value | rgb | map(tostring) | join(","))/g\ns/@\(.key)_hex@/\(.value[1:])/g\ns/@\(.key)@/\(.value)/g"),
      "s/@accent_name@/\($a)/g",
      "s/@flavour@/\($f)/g",
      "s/@Flavour@/\($f[0:1] | ascii_upcase)\($f[1:])/g",
      "s/@dark@/\($dark)/g",
      "s/@mode@/\(if $d then "dark" else "light" end)/g",
      "s/@shadow_alpha@/\(if $d then "cc" else "59" end)/g",
      "s/@lock_brightness@/\(if $d then "0.55" else "1.0" end)/g",
      "s/@gtk_theme@/\($gtk)/g",
      "s/@color_scheme@/\($scheme)/g",
      "s/@icon_theme@/\($icons)/g",
      "s/@kvantum_theme@/torus/g"
  ' "$REPO/theme/$flavour.json"
  printf 's|@state@|%s|g\n' "$(printf '%s' "$STATE" | sed 's/[|&\\]/\\&/g')"
}

render() {
  local accent=$1 flavour=${2:-$(current_flavour)} script tmp t e
  script=$(sed_script "$accent" "$flavour")
  mkdir -p "$STATE"
  tmp=$(mktemp -d "$STATE/.theme.XXXXXX")
  for t in "$REPO"/theme/templates/*.tmpl; do
    sed "$script" "$t" > "$tmp/$(basename "$t" .tmpl)"
  done
  local kv="" hex base dim
  if [[ $flavour == mocha && -f $REPO/home/.config/Kvantum/hyde-mocha/hyde-mocha.kvconfig ]]; then
    kv=$REPO/home/.config/Kvantum/hyde-mocha/hyde-mocha
  elif [[ -f $REPO/theme/kvantum/catppuccin-$flavour.kvconfig ]]; then
    kv=$REPO/theme/kvantum/catppuccin-$flavour
  fi
  if [[ -n $kv ]]; then
    hex=$(jq -r --arg a "$accent" '.[$a]' "$REPO/theme/$flavour.json")
    mkdir -p "$tmp/kvantum"
    base=$(jq -r .base "$REPO/theme/$flavour.json")
    dim=$(printf '#%02x%02x%02x' $(((16#${hex:1:2} * 7 + 16#${base:1:2} * 3) / 10)) $(((16#${hex:3:2} * 7 + 16#${base:3:2} * 3) / 10)) $(((16#${hex:5:2} * 7 + 16#${base:5:2} * 3) / 10)))
    sed "$script" "$kv.svg" | sed "s/#F5E0DC/$hex/Ig; s/#CBA6F7/$hex/Ig; s/#9670B0/$dim/Ig" > "$tmp/kvantum/torus.svg"
    sed "$script" "$kv.kvconfig" | sed -E "s/^((inactive\.)?highlight\.color|link\.color)=.*/\1=$hex/" > "$tmp/kvantum/torus.kvconfig"
  fi
  if [[ -d $STATE/theme ]]; then
    mv -T --exchange "$tmp" "$STATE/theme"
    rm -rf "$tmp"
  else
    mv "$tmp" "$STATE/theme"
  fi
  echo "$accent" > "$STATE/accent"
  echo "$flavour" > "$STATE/flavour"
}

link_state() {
  local src=$STATE/theme/$1 dst=$HOME/$2
  [[ -e $dst && ! -L $dst ]] && return 0
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$src" "$dst"
}

link_configs() {
  link_state hyprtoolkit.conf .config/hypr/hyprtoolkit.conf
  link_state starship.toml .config/starship/starship.toml
  link_state yazi-theme.toml .config/yazi/theme.toml
  link_state lazygit.yml .config/lazygit/config.yml
  link_state kvantum.kvconfig .config/Kvantum/kvantum.kvconfig
  link_state kvantum .config/Kvantum/torus
  link_state qt6ct.conf .config/qt6ct/qt6ct.conf
  link_state kdeglobals .config/kdeglobals
  link_state gtk-settings.ini .config/gtk-3.0/settings.ini
  link_state gtk-settings.ini .config/gtk-4.0/settings.ini
}

apply_gsettings() {
  command -v gsettings > /dev/null || return 0
  flavour_meta "$1" "${2:-}"
  local g=org.gnome.desktop.interface
  gsettings set $g gtk-theme "$GTK_THEME" || true
  gsettings set $g color-scheme "$COLOR_SCHEME" || true
  gsettings set $g icon-theme "$ICON_THEME" || true
}

render_art() {
  command -v deno > /dev/null || return 0
  local tmp
  tmp=$(mktemp -d)
  deno run --quiet --allow-read --allow-write --allow-run --allow-env "$REPO/donut/render-frames.ts" "$tmp" 1 600 transparent > /dev/null 2>&1 || true
  [[ -s $tmp/frame-0000.png ]] && mv "$tmp/frame-0000.png" "$STATE/donut.png" || warn "donut.png not rendered"
  rm -rf "$tmp"
  deno run --quiet --allow-read --allow-write --allow-env "$REPO/donut/render-logo.ts" "$STATE/fastfetch" > /dev/null 2>&1 || warn "fastfetch colours not rendered"
}

install_app_themes() {
  local t=$STATE/theme
  install -D -m 644 "$t/gtk.css" "$HOME/.config/gtk-3.0/gtk.css"
  install -D -m 644 "$t/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
  install -D -m 644 "$t/btop.theme" "$HOME/.config/btop/themes/torus.theme"
  local bc=$HOME/.config/btop/btop.conf
  [[ -L $bc ]] && rm -f "$bc"
  if [[ -f $bc ]]; then
    grep -q '^color_theme' "$bc" && sed -i 's|^color_theme *=.*|color_theme = "torus"|' "$bc" || echo 'color_theme = "torus"' >> "$bc"
  else
    printf '%s\n' 'color_theme = "torus"' 'theme_background = false' 'truecolor = true' 'rounded_corners = true' \
      'vim_keys = true' 'graph_symbol = "braille"' 'update_ms = 2000' > "$bc"
  fi
  local hex profile user
  hex=$(jq -r '.accent // empty' "$t/qs-colors.json" 2> /dev/null)
  if [[ -n $hex ]]; then
    for profile in "$HOME"/.var/app/app.zen_browser.zen/.zen/*/ "$HOME"/.zen/*/; do
      [[ -f $profile/prefs.js ]] || continue
      user=$profile/user.js
      {
        [[ -f $user ]] && sed '/^\/\/ torus accent start$/,/^\/\/ torus accent end$/d' "$user"
        echo "// torus accent start"
        printf 'user_pref("zen.theme.accent-color", "%s");\n' "$hex"
        echo "// torus accent end"
      } > "$user.torus" && mv "$user.torus" "$user"
    done
  fi
  if [[ -d $HOME/.config/vesktop ]]; then
    mkdir -p "$HOME/.config/vesktop/themes"
    printf '@import url("https://catppuccin.github.io/discord/dist/catppuccin-%s-%s.theme.css");\n' "$(current_flavour)" "$(current_accent)" > "$HOME/.config/vesktop/themes/torus.theme.css"
  fi
}

reload() {
  local accent=$1 flavour
  flavour=$(current_flavour)
  install_app_themes
  "$(dirname "$SELF")/torus-mangohud" apply > /dev/null 2>&1 || true
  hyprctl eval "dofile('$STATE/theme/hypr-colors.lua')" > /dev/null 2>&1 || warn "hyprland not reachable, borders update on next login"
  qs -c torus ipc call torus reloadTheme > /dev/null 2>&1 || warn "shell not reachable"
  pkill -USR1 -x kitty || true
  local chadrc=$HOME/.config/nvim/lua/chadrc.lua
  if [[ -f $chadrc ]] && grep -q -- '-- torus accent start' "$chadrc"; then
    awk -v a="$accent" -v f="$flavour" '
      /-- torus accent start/ { print; print "M.torus_accent = \"" a "\""; print "M.torus_flavour = \"" f "\""; skip = 1; next }
      /-- torus accent end/ { skip = 0 }
      !skip' "$chadrc" > "$chadrc.torus" && mv "$chadrc.torus" "$chadrc"
  fi
}

cmd_accent() {
  if (($# == 0)); then
    current_accent
    return
  fi
  local accent=$1
  [[ " ${ACCENTS[*]} " == *" $accent "* ]] || { warn "unknown accent: $accent (one of: ${ACCENTS[*]})"; exit 2; }
  render "$accent"
  reload "$accent"
  apply_gsettings "$(current_flavour)" "$accent"
  echo "accent: $accent"
  after_note
}

after_note() {
  echo "Qt apps already open (Dolphin) pick it up when restarted"
  [[ -d ${TORUS_BOOT:-/boot}/grub/themes/marc-os ]] && echo "boot screens follow on the next: sudo ./install.sh --system"
  return 0
}

cmd_flavour() {
  if (($# == 0)); then
    current_flavour
    return
  fi
  local flavour=$1 accent before
  [[ " ${FLAVOURS[*]} " == *" $flavour "* ]] || { warn "unknown flavour: $flavour (one of: ${FLAVOURS[*]})"; exit 2; }
  accent=$(current_accent)
  before=$(current_flavour)
  render "$accent" "$flavour"
  link_configs
  reload "$accent"
  apply_gsettings "$flavour"
  render_art
  if command -v bat > /dev/null; then bat cache --build > /dev/null 2>&1 || true; fi
  if [[ $before != "$flavour" && ( $before == latte || $flavour == latte ) ]]; then
    systemctl --user restart --no-block torus-shell.service > /dev/null 2>&1 || true
  fi
  echo "flavour: $flavour"
  after_note
}

cmd_setup() {
  local accent flavour
  accent=$(current_accent)
  flavour=$(current_flavour)
  render "$accent" "$flavour"
  link_configs
  reload "$accent" 2> /dev/null || true
  apply_gsettings "$flavour"
  local g=org.gnome.desktop.interface
  gsettings set $g font-name "Cantarell 10" || true
  gsettings set $g monospace-font-name "JetBrainsMono Nerd Font 10" || true
  gsettings set $g cursor-size 24 || true
  gsettings set $g cursor-theme Bibata-Modern-Ice || true
  bat cache --build > /dev/null 2>&1 || true
  fc-cache > /dev/null 2>&1 || true
  local qsb frag
  qsb=$(command -v qsb || echo /usr/lib/qt6/bin/qsb)
  if [[ -x $qsb ]]; then
    mkdir -p "$STATE/shaders"
    while IFS= read -r -d '' frag; do
      "$qsb" --glsl "100 es,120,150" --hlsl 50 --msl 12 -o "$STATE/shaders/$(basename "$frag").qsb" "$frag"
    done < <(find "$REPO/home/.config/quickshell" -name '*.frag' -print0)
  else
    warn "qsb missing (qt6-shadertools), the donut cannot render"
  fi
  local layout
  layout=$(cat "$STATE/hyprlock" 2> /dev/null || echo marc-os)
  [[ -e $STATE/hyprlock-layout.conf ]] || ln -sfn "$HOME/.config/hypr/hyprlock/$layout.conf" "$STATE/hyprlock-layout.conf"
  [[ -s $STATE/donut.png ]] || render_art
  local inc
  for inc in "$HOME/.config/torus/delta.gitconfig" "$STATE/theme/delta.gitconfig"; do
    git config --global --get-all include.path 2> /dev/null | grep -qxF "$inc" || git config --global --add include.path "$inc"
  done
  systemctl --user daemon-reload > /dev/null 2>&1 || true
  systemctl --user enable torus-shell.service > /dev/null 2>&1 || true
  systemctl --user enable --now torus-session-save.timer > /dev/null 2>&1 || true
  systemctl --user mask dunst.service > /dev/null 2>&1 || true
  echo "torus: setup done (flavour $flavour, accent $accent)"
}

cmd_safe() {
  systemctl --user stop torus-shell.service
  systemctl --user start torus-safe.service
  echo "torus: safe mode, torus unsafe brings the full shell back"
}

cmd_unsafe() {
  systemctl --user reset-failed torus-shell.service 2> /dev/null || true
  systemctl --user start torus-shell.service
  echo "torus: full shell started"
}

(($#)) || { echo "usage: torus accent|flavour|setup|doctor|ipc|safe|unsafe" >&2; exit 1; }
cmd=$1
shift
case $cmd in
  accent) cmd_accent "$@" ;;
  flavour | flavor) cmd_flavour "$@" ;;
  setup) cmd_setup ;;
  doctor) exec "$(dirname "$SELF")/torus-doctor" "$@" ;;
  ipc) exec "$(dirname "$SELF")/torus-ipc" "$@" ;;
  safe) cmd_safe ;;
  unsafe) cmd_unsafe ;;
  *) echo "unknown command: $cmd" >&2; exit 1 ;;
esac
