#!/usr/bin/env python3
import ctypes
import json
import os
import select
import struct
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
DIR = os.environ.get("TORUS_DOWNLOADS") or os.environ.get("XDG_DOWNLOAD_DIR") or os.path.join(HOME, "Downloads")
PARTIAL = (".part", ".crdownload")
IN_MODIFY, IN_MOVED_FROM, IN_MOVED_TO, IN_CREATE, IN_DELETE, IN_CLOSE_WRITE = 0x2, 0x40, 0x80, 0x100, 0x200, 0x8
WINDOW = 10.0


def emit(ev):
    print(json.dumps(ev), flush=True)


def human(b):
    for unit, size in (("GB", 1 << 30), ("MB", 1 << 20), ("KB", 1 << 10)):
        if b >= size:
            return f"{b / size:.1f} {unit}"
    return f"{b} B"


def final_name(partial):
    for ext in PARTIAL:
        if partial.endswith(ext):
            return partial[: -len(ext)]
    return partial


class Jobs:
    def __init__(self, notify):
        self.jobs = {}
        self.notify = notify

    def touch(self, name, now):
        path = os.path.join(DIR, name)
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        j = self.jobs.setdefault(name, {"samples": [], "sent": 0, "since": now})
        j["samples"].append((now, size))
        while len(j["samples"]) > 2 and now - j["samples"][0][0] > WINDOW:
            j["samples"].pop(0)
        if now - j["sent"] < 1 and len(j["samples"]) > 1:
            return
        j["sent"] = now
        (t0, s0), (t1, s1) = j["samples"][0], j["samples"][-1]
        rate = (s1 - s0) / (t1 - t0) if t1 > t0 else 0
        title = final_name(name)
        if title.startswith("Unconfirmed "):
            title = "download"
        emit({"kind": "download", "state": "running", "id": name, "name": title, "size": human(size),
              "speed": human(rate) + "/s" if rate > 0 else "", "pct": -1})

    def finish(self, partial, final, now):
        j = self.jobs.pop(partial, None)
        if j is None:
            return
        path = os.path.join(DIR, final)
        if not os.path.exists(path) or final.endswith(PARTIAL) or os.path.getsize(path) == 0:
            emit({"kind": "download", "state": "stopped", "id": partial, "name": final_name(partial)})
            return
        emit({"kind": "download", "state": "done", "id": partial, "name": final, "path": path, "size": human(os.path.getsize(path))})
        self.notify(path)

    def gone(self, partial, now):
        if partial not in self.jobs:
            return
        final = final_name(partial)
        if final.startswith("Unconfirmed "):
            self.jobs.pop(partial, None)
            emit({"kind": "download", "state": "stopped", "id": partial, "name": final})
            return
        self.finish(partial, final, now)


def notify(path):
    def run():
        name = os.path.basename(path)
        try:
            r = subprocess.run(["notify-send", "-a", "Downloads", "-i", "folder-download", "-A", "open=Open", "-A", "folder=Show in folder",
                                "Downloaded", name], capture_output=True, text=True, timeout=3600)
        except (OSError, subprocess.TimeoutExpired):
            return
        act = r.stdout.strip()
        if act == "open":
            subprocess.Popen(["torus-launch", "xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif act == "folder":
            uri = "file://" + path
            if subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.FileManager1", "--object-path", "/org/freedesktop/FileManager1",
                               "--method", "org.freedesktop.FileManager1.ShowItems", f"['{uri}']", ""], capture_output=True).returncode != 0:
                subprocess.Popen(["torus-launch", "xdg-open", os.path.dirname(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    threading.Thread(target=run, daemon=True).start()


def follow():
    os.makedirs(DIR, exist_ok=True)
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.inotify_init1(os.O_CLOEXEC)
    if fd < 0:
        sys.exit("torus-downloads: inotify_init1 failed")
    if libc.inotify_add_watch(fd, DIR.encode(), IN_MODIFY | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_CLOSE_WRITE) < 0:
        sys.exit("torus-downloads: cannot watch " + DIR)
    jobs = Jobs(notify)
    moved = {}
    while True:
        select.select([fd], [], [])
        data = os.read(fd, 65536)
        now = time.time()
        i = 0
        while i + 16 <= len(data):
            _, mask, cookie, length = struct.unpack_from("iIII", data, i)
            name = data[i + 16:i + 16 + length].split(b"\0", 1)[0].decode("utf-8", "replace")
            i += 16 + length
            if mask & IN_MOVED_FROM:
                moved[cookie] = name
            elif mask & IN_MOVED_TO:
                src = moved.pop(cookie, None)
                if src and src.endswith(PARTIAL):
                    if name.endswith(PARTIAL):
                        jobs.jobs[name] = jobs.jobs.pop(src, {"samples": [], "sent": 0, "since": now})
                    else:
                        jobs.finish(src, name, now)
            elif mask & IN_DELETE:
                if name.endswith(PARTIAL):
                    jobs.gone(name, now)
            elif mask & (IN_MODIFY | IN_CREATE) and name.endswith(PARTIAL):
                jobs.touch(name, now)


def main():
    a = sys.argv[1:] or ["follow"]
    if a[0] == "follow":
        follow()
    else:
        sys.exit("usage: torus-downloads follow")


if __name__ == "__main__":
    main()
