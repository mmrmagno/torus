#!/usr/bin/env python3
import fcntl
import glob
import json
import os
import re
import select
import signal
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONF = os.environ.get("TORUS_GAMES_CONF", os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "torus", "games.json"))
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "torus")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", HOME + "/.cache"), "torus")
VIDEOS = os.environ.get("XDG_VIDEOS_DIR", HOME + "/Videos")
CLIPS = os.path.join(VIDEOS, "Clips")
LOGS = os.path.join(CACHE, "mangohud-logs")
SESSION = os.path.join(STATE, "play-session.json")
LAST = os.path.join(STATE, "play-last.json")
DEFAULTS = {"overlay": "keep", "power": "performance", "replay": "on", "replay_secs": 60, "hold": "on", "gamescope": "off",
            "highlights": "on", "hl_3k": "on", "hl_4k": "on", "hl_ace": "on", "hl_clutch": "on", "clip_audio": "everything"}
CHOICES = {"overlay": ["keep", "on", "off"], "power": ["performance", "balanced", "keep"], "replay": ["on", "off"],
           "replay_secs": [30, 60, 120], "hold": ["on", "off"], "gamescope": ["on", "off"],
           "highlights": ["on", "off"], "hl_3k": ["on", "off"], "hl_4k": ["on", "off"], "hl_ace": ["on", "off"], "hl_clutch": ["on", "off"],
           "clip_audio": ["everything", "game + mic", "game"]}
GSI_APPS = {"730"}
GSI_MATCH = os.path.join(STATE, "gsi-match.json")
GSI_PENDING = os.path.join(STATE, "gsi-pending")
FAVS = os.path.join(STATE, "clip-favorites.json")
BUDGETS = [0, 25, 50, 100]
GB = int(os.environ.get("TORUS_CLIP_GB", str(1 << 30)))
AUTO_RE = re.compile(r"-(ace|4k|3k|clutch)-\d{4}-\d{2}-\d{2}-\d{6}(-\d+)?\.mp4$")
FRESH_SECS = 600


def clip_files(dirs, newest=True):
    out = []
    for d in dirs:
        for p in glob.glob(os.path.join(d, "*.mp4")):
            if p.endswith(".part.mp4"):
                continue
            try:
                st = os.stat(p)
            except OSError:
                continue
            out.append((p, st.st_mtime, st.st_size))
    return sorted(out, key=lambda f: f[1], reverse=newest)


def free_dest(base):
    for n in range(1, 1000):
        dest = base + ("" if n == 1 else f"-{n}") + ".mp4"
        try:
            os.close(os.open(dest, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644))
            return dest
        except FileExistsError:
            continue
    raise OSError("no free clip name for " + base)


def run(*cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=kw.get("timeout", 10)).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def settings(appid):
    s = dict(DEFAULTS)
    s.update(load(CONF, {}).get(str(appid), {}))
    return s


def game_name(appid):
    for line in run("torus-games").splitlines():
        f = line.split("\t")
        if f and f[0] == str(appid):
            return f[1]
    return "Game " + str(appid) if appid else "Game"


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "game"


def ipc(*args):
    run("qs", "-c", "torus", "ipc", "call", "torus", *args, timeout=3)


PROC = os.environ.get("TORUS_PROC", "/proc")


def appid_of(cls):
    m = re.match(r"^steam_app_(\d+)$", cls or "")
    if m:
        return m.group(1)
    try:
        clients = json.loads(run("hyprctl", "clients", "-j") or "[]")
    except ValueError:
        return ""
    for c in clients:
        if c.get("class") != cls or not c.get("pid"):
            continue
        try:
            env = open(os.path.join(PROC, str(c["pid"]), "environ"), "rb").read().split(b"\0")
        except OSError:
            continue
        for e in env:
            if e.startswith(b"SteamAppId="):
                v = e.split(b"=", 1)[1].decode()
                return v if v.isdigit() and v != "0" else ""
    return ""


def monitor_of(cls):
    try:
        clients = json.loads(run("hyprctl", "clients", "-j") or "[]")
        mons = json.loads(run("hyprctl", "monitors", "-j") or "[]")
    except ValueError:
        return ""
    mid = next((c.get("monitor") for c in clients if c.get("class") == cls), None)
    return next((m["name"] for m in mons if m.get("id") == mid), mons[0]["name"] if mons else "")


def window_capture():
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "hypr", "xdph.conf")
    return "torus-share-picker" in load_text(conf) and shutil.which("torus-share-picker") is not None


def start_replay(cls, mon, audio, secs):
    base = ["-f", "60", "-a", audio, "-c", "mp4", "-r", str(secs), "-sc", os.path.abspath(sys.argv[0]) + "-saved", "-o", VIDEOS]
    if window_capture():
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "share-target"), "w") as f:
            f.write(cls + "\n")
        p = subprocess.Popen(["gpu-screen-recorder", "-w", "portal", "-restore-portal-session", "no"] + base,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(25):
            if p.poll() is not None:
                break
            time.sleep(0.2)
        if p.poll() is None:
            return "window", p.pid
        try:
            os.remove(os.path.join(STATE, "share-target"))
        except OSError:
            pass
    p = subprocess.Popen(["gpu-screen-recorder", "-w", mon] + base, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return "monitor", p.pid


def replay_procs():
    out = run("pgrep", "-af", "gpu-screen-recorder .*-r ")
    return [l for l in out.splitlines() if "gpu-screen-recorder" in l]


def stop_plain_replay():
    if not any("-saved" not in l for l in replay_procs()):
        return
    run("pkill", "-INT", "-f", "gpu-screen-recorder .*-r ")
    for _ in range(30):
        if not replay_running():
            break
        time.sleep(0.1)


def ours(pid, word):
    try:
        return word in open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace")
    except (OSError, ValueError):
        return False


def stop_keeper(sess):
    k = sess.get("keeper")
    if isinstance(k, int) and k != os.getpid() and ours(k, "replay-keep"):
        try:
            os.kill(k, signal.SIGTERM)
        except OSError:
            pass


def cmd_keep():
    deaths = []
    for _ in range(30):
        if (load(SESSION, None) or {}).get("keeper") == os.getpid():
            break
        time.sleep(0.1)
    while True:
        sess = load(SESSION, None)
        if not sess or sess.get("keeper") != os.getpid() or not sess.get("replay"):
            return
        pid = sess.get("replay_pid")
        try:
            fd = os.pidfd_open(pid)
            select.select([fd], [], [])
            os.close(fd)
        except (OSError, TypeError):
            pass
        sess = load(SESSION, None)
        if not sess or sess.get("keeper") != os.getpid():
            return
        if not window_open(sess.get("class", "")):
            cmd_end(closed=True)
            return
        now = time.time()
        deaths = [t for t in deaths if now - t < 120] + [now]
        if len(deaths) > 3:
            ipc("islandFlash", "notification", "The replay buffer keeps stopping, clips are off for this game")
            sess["replay"] = False
            save(SESSION, sess)
            return
        time.sleep(1)
        cls = sess.get("class", "")
        s = settings(sess.get("appid", ""))
        mon = monitor_of(cls)
        if not mon:
            return
        sess["capture"], sess["replay_pid"] = start_replay(cls, mon, replay_audio(cls, s["clip_audio"]), int(sess.get("replay_secs", 60)))
        cur = load(SESSION, None)
        if not cur or cur.get("keeper") != os.getpid():
            return
        cur.update({"capture": sess["capture"], "replay_pid": sess["replay_pid"]})
        save(SESSION, cur)


def game_binary(cls):
    try:
        clients = json.loads(run("hyprctl", "clients", "-j") or "[]")
    except ValueError:
        return ""
    for c in clients:
        if c.get("class") == cls and c.get("pid"):
            try:
                return open(os.path.join(PROC, str(c["pid"]), "comm")).read().strip()
            except OSError:
                return ""
    return ""


def replay_audio(cls, mode):
    mic = load_text(os.path.join(STATE, "replay-mic"))
    game = game_binary(cls) if mode != "everything" else ""
    if not game:
        return "default_output" + ("|" + mic if mic else "")
    if mode == "game":
        return "app:" + game
    return "app:" + game + "|" + (mic or "default_input")


def encoder_broken():
    try:
        r = subprocess.run(["journalctl", "-k", "-b", "-q", "--no-pager", "-o", "cat", "-g", "ring vcn_unified_[0-9]+ timeout", "-n", "1"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and "timeout" in r.stdout


def replay_running():
    return run("pgrep", "-f", "gpu-screen-recorder .*-r ").strip() != ""


def window_open(cls):
    try:
        return any(c.get("class") == cls for c in json.loads(run("hyprctl", "clients", "-j") or "[]"))
    except ValueError:
        return True


def cmd_start(cls):
    old = load(SESSION, None)
    if old is not None:
        if window_open(old.get("class", "")):
            return
        stop_keeper(old)
        if old.get("replay"):
            run("pkill", "-INT", "-f", "gpu-screen-recorder .*-r ")
            for _ in range(30):
                if not replay_running():
                    break
                time.sleep(0.1)
        if old.get("gsi"):
            run("pkill", "-f", "torus-gsi serve")
        os.remove(SESSION)
    appid = appid_of(cls)
    s = settings(appid)
    name = game_name(appid)
    sess = {"appid": appid, "class": cls, "name": name, "start": time.time(), "clips": 0, "replay": False, "overlay_before": "", "hold": s["hold"]}
    save(SESSION, sess)
    if s["overlay"] in ("on", "off"):
        sess["overlay_before"] = run("torus-mangohud", "status").strip()
        run("torus-mangohud", s["overlay"])
    if s["power"] == "balanced":
        run("powerprofilesctl", "set", "balanced")
    if s["replay"] == "on" and not replay_running() and shutil.which("gpu-screen-recorder") and encoder_broken():
        s = dict(s, replay="off")
        ipc("islandFlash", "notification", "Replay buffer off until a reboot: the video encoder hung after a GPU reset")
    if s["replay"] == "on" and shutil.which("gpu-screen-recorder"):
        stop_plain_replay()
    if s["replay"] == "on" and not replay_running() and shutil.which("gpu-screen-recorder"):
        mon = monitor_of(cls)
        if mon:
            audio = replay_audio(cls, s["clip_audio"])
            os.makedirs(VIDEOS, exist_ok=True)
            kind, pid = start_replay(cls, mon, audio, int(s["replay_secs"]))
            sess.update({"capture": kind, "replay_pid": pid, "replay": True, "replay_secs": int(s["replay_secs"])})
    if appid in GSI_APPS and shutil.which("torus-gsi"):
        run("torus-gsi", "install", "--quiet")
        subprocess.Popen(["setsid", "-f", "torus-gsi", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sess["gsi"] = True
    cur = load(SESSION, {})
    sess["clips"] = max(sess["clips"], cur.get("clips", 0))
    save(SESSION, sess)
    if sess.get("replay_pid"):
        k = subprocess.Popen([os.path.abspath(sys.argv[0]), "replay-keep"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        cur = load(SESSION, {})
        cur["keeper"] = k.pid
        save(SESSION, cur)


def load_text(path):
    try:
        return open(path).read().strip()
    except OSError:
        return ""


def recap(sess):
    start = sess.get("start", 0)
    logs = [p for p in glob.glob(os.path.join(LOGS, "*.csv")) if os.path.getmtime(p) >= start - 5]
    fps, ft, temp = [], [], []
    for p in logs:
        cols = None
        for line in open(p, errors="replace"):
            parts = line.strip().split(",")
            if cols is None:
                if parts and parts[0] == "fps":
                    cols = parts
                continue
            if len(parts) != len(cols):
                continue
            row = dict(zip(cols, parts))
            try:
                fps.append(float(row["fps"]))
                ft.append(float(row.get("frametime", 0) or 0))
                if row.get("gpu_temp"):
                    temp.append(float(row["gpu_temp"]))
            except ValueError:
                continue
    out = {"name": sess.get("name", "Game"), "appid": sess.get("appid", ""), "start": start, "end": time.time(),
           "minutes": round((time.time() - start) / 60), "clips": sess.get("clips", 0)}
    if fps:
        out["fps_avg"] = round(sum(fps) / len(fps))
        frames = sorted(ft)
        worst = frames[int(len(frames) * 0.99)] if frames and frames[-1] > 0 else 0
        out["fps_low1"] = round(1000 / worst) if worst > 0 else round(sorted(fps)[max(0, len(fps) // 100)])
    if temp:
        out["gpu_temp_max"] = round(max(temp))
    m = load(GSI_MATCH, None) if sess.get("gsi") else None
    if m and m.get("start", 0) >= start - 5 and m.get("map"):
        mine = m.get("ct" if m.get("team") == "CT" else "t", 0)
        theirs = m.get("t" if m.get("team") == "CT" else "ct", 0)
        out["match"] = {"map": m["map"], "score": f"{mine}:{theirs}", "kills": m.get("kills", 0), "deaths": m.get("deaths", 0),
                        "mvps": m.get("mvps", 0), "best": m.get("best", 0), "best_round": m.get("best_round", 0)}
        out["auto_clips"] = sess.get("auto_clips", 0)
    return out


def recap_text(r):
    m = r["minutes"]
    parts = ["played " + (f"{m // 60} h {m % 60:02d}" if m >= 60 else f"{m} min")]
    if "fps_avg" in r:
        parts.append(f"average {r['fps_avg']} FPS")
        parts.append(f"1 % low {r['fps_low1']}")
    if "gpu_temp_max" in r:
        parts.append(f"GPU max {r['gpu_temp_max']} °C")
    m = r.get("match")
    if m:
        parts.insert(0, f"{m['map']} {m['score']}")
        parts.insert(1, f"{m['kills']}/{m['deaths']} K/D")
        if m["mvps"]:
            parts.insert(2, f"{m['mvps']} MVP" + ("s" if m["mvps"] != 1 else ""))
        if m["best"] >= 2:
            parts.append(f"best round {'ace' if m['best'] >= 5 else str(m['best']) + 'K'} (round {m['best_round']})")
    if r["clips"]:
        auto = r.get("auto_clips", 0)
        parts.append(f"{r['clips']} clip" + ("s" if r["clips"] != 1 else "") + " saved" + (f" ({auto} auto)" if auto else ""))
    return r["name"] + ": " + " · ".join(parts)


def cmd_end(closed=False):
    sess = load(SESSION, None)
    if not sess:
        return
    if not closed and window_open(sess.get("class", "")):
        return
    stop_keeper(sess)
    if sess.get("replay"):
        run("pkill", "-INT", "-f", "gpu-screen-recorder .*-r ")
    if sess.get("gsi"):
        run("pkill", "-f", "torus-gsi serve")
    if sess.get("overlay_before") in ("on", "off"):
        run("torus-mangohud", sess["overlay_before"])
    try:
        os.remove(os.path.join(STATE, "mangohud-log"))
    except OSError:
        pass
    run("torus-mangohud", "apply")
    r = recap(sess)
    os.remove(SESSION)
    if r["minutes"] < 1 and not r["clips"]:
        return
    save(LAST, r)
    ipc("islandFlash", "notification", recap_text(r))


def cmd_saved(path):
    sess = load(SESSION, {})
    name = sess.get("name") or "Game"
    dest_dir = os.path.join(CLIPS, slug(name))
    os.makedirs(dest_dir, exist_ok=True)
    auto = ""
    try:
        if time.time() - os.path.getmtime(GSI_PENDING) < 30:
            auto = load_text(GSI_PENDING)
        os.remove(GSI_PENDING)
    except OSError:
        pass
    if auto not in ("ace", "4k", "3k", "clutch"):
        auto = ""
    try:
        dest = free_dest(os.path.join(dest_dir, slug(name) + "-" + (auto + "-" if auto else "") + time.strftime("%Y-%m-%d-%H%M%S")))
    except OSError:
        dest = path
    if dest != path:
        try:
            shutil.move(path, dest)
        except OSError:
            try:
                os.remove(dest)
            except OSError:
                pass
            dest = path
    if sess:
        sess["clips"] = sess.get("clips", 0) + 1
        if auto:
            sess["auto_clips"] = sess.get("auto_clips", 0) + 1
        save(SESSION, sess)
    secs = sess.get("replay_secs", 60)
    if not auto:
        ipc("islandFlash", "notification", f"Clip saved · {name} · {secs} s")
    print(dest)
    if budget() > 0:
        subprocess.Popen([os.path.abspath(sys.argv[0]), "cleanup"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def thumb_path(path):
    return os.path.join(CACHE, "clip-thumbs", re.sub(r"[^A-Za-z0-9._-]", "_", os.path.relpath(path, CLIPS)) + ".jpg")


def thumb(path):
    d = os.path.join(CACHE, "clip-thumbs")
    os.makedirs(d, exist_ok=True)
    t = thumb_path(path)
    if not os.path.exists(t) or os.path.getmtime(t) < os.path.getmtime(path):
        run("ffmpeg", "-v", "error", "-y", "-ss", "1", "-i", path, "-frames:v", "1", "-vf", "scale=320:-2", t, timeout=20)
    return t if os.path.exists(t) else ""


def cmd_clips(appid):
    favs = set(favorites())
    dirs = [os.path.join(CLIPS, slug(game_name(appid)))] if appid else glob.glob(os.path.join(CLIPS, "*"))
    for p, mtime, size in clip_files(dirs)[:12]:
        m = AUTO_RE.search(p)
        print("\t".join([p, str(int(mtime)), thumb(p), str(size), m.group(1) if m else "", "1" if p in favs else "0"]))


def favorites():
    f = load(FAVS, [])
    return [p for p in f if isinstance(p, str)]


def cmd_fav(path, state):
    path = os.path.abspath(path)
    f = [p for p in favorites() if p != path]
    if state == "on" or (state == "toggle" and path not in favorites()):
        f.insert(0, path)
    save(FAVS, f)
    print("on" if path in f else "off")


def same_file(a, b):
    return os.path.realpath(a) == os.path.realpath(b)


def cmd_rename(path, name):
    path = os.path.abspath(path)
    root = os.path.realpath(CLIPS)
    real = os.path.realpath(path)
    if os.path.commonpath([real, root]) != root or not os.path.isfile(real):
        sys.exit("not a clip: " + path)
    ext = os.path.splitext(path)[1]
    name = name.strip()
    if name.lower().endswith(ext.lower()):
        name = name[:-len(ext)].strip()
    if not name or len(name) > 120 or name.startswith(".") or re.search(r"[/\x00-\x1f]", name):
        sys.exit("that name does not work: letters, numbers and spaces, no slash, not empty")
    new = os.path.join(os.path.dirname(path), name + ext)
    if new == path:
        print(path)
        return
    if os.path.lexists(new):
        sys.exit("a clip with that name is already there")
    old_thumb = thumb_path(path)
    f = favorites()
    was_fav = any(same_file(p, path) for p in f)
    os.rename(path, new)
    if was_fav:
        save(FAVS, [new] + [p for p in f if os.path.realpath(p) != real])
    if os.path.exists(old_thumb):
        os.replace(old_thumb, thumb_path(new))
    print(new)


def cmd_library():
    favs = set(favorites())
    names = {}
    for line in run("torus-games").splitlines():
        parts = line.split("\t")
        if len(parts) > 1:
            names[slug(parts[1])] = parts[1]
    for p, mtime, size in clip_files(glob.glob(os.path.join(CLIPS, "*"))):
        game = os.path.basename(os.path.dirname(p))
        m = AUTO_RE.search(p)
        t = thumb_path(p)
        print("\t".join([p, str(int(mtime)), t if os.path.exists(t) else "", str(size), m.group(1) if m else "",
                         game, names.get(game, game.replace("-", " ").title()), "1" if p in favs else "0"]))


def cmd_thumbs(limit=60):
    made = 0
    for p, mtime, _ in clip_files(glob.glob(os.path.join(CLIPS, "*")))[:limit]:
        t = thumb_path(p)
        if not os.path.exists(t) or os.path.getmtime(t) < mtime:
            thumb(p)
            made += 1
    print(made)


def budget():
    try:
        return int(load(CONF, {}).get("_clips", {}).get("budget", 0))
    except (TypeError, ValueError):
        return 0


def cmd_budget(value):
    if value is not None:
        v = int(value)
        if v not in BUDGETS:
            sys.exit(f"budget takes one of {BUDGETS} (GB, 0 is off)")
        conf = load(CONF, {})
        conf.setdefault("_clips", {})["budget"] = v
        save(CONF, conf)
    print(budget())


def cleanup():
    b = budget()
    if b <= 0:
        return []
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, "clip-cleanup.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    files = clip_files(glob.glob(os.path.join(CLIPS, "*")), newest=False)
    total = sum(f[2] for f in files)
    limit = b * GB
    favs = {os.path.realpath(p) for p in favorites()}
    if sum(f[2] for f in files if os.path.realpath(f[0]) in favs) > limit:
        return None
    gone = []
    for p, mtime, size in files:
        if total <= limit:
            break
        if os.path.realpath(p) in favs or time.time() - mtime < FRESH_SECS:
            continue
        subprocess.run(["torus-trash", "put", p], capture_output=True)
        if not os.path.lexists(p):
            total -= size
            gone.append((p, size))
    return gone


def cmd_cleanup():
    gone = cleanup()
    if gone is None:
        mark = os.path.join(STATE, "clip-budget-warned")
        today = time.strftime("%Y-%m-%d")
        if load_text(mark) != today:
            with open(mark, "w") as f:
                f.write(today)
            ipc("islandFlash", "notification", f"Your favorites alone are over the {budget()} GB clip budget, so no clip was removed")
        return
    for p, _ in gone:
        print(p)
    if gone:
        ipc("islandFlash", "notification", f"Clips over {budget()} GB: {len(gone)} old clip" + ("s" if len(gone) != 1 else "") + f" to the trash ({sum(z for _, z in gone) / GB:.1f} GB)")


def cmd_set(appid, key, value):
    if key not in CHOICES:
        sys.exit("unknown setting " + key)
    v = int(value) if key == "replay_secs" else value
    if v not in CHOICES[key]:
        sys.exit(f"{key} takes one of {CHOICES[key]}")
    conf = load(CONF, {})
    conf.setdefault(str(appid), {})[key] = v
    save(CONF, conf)


def main():
    a = sys.argv[1:] or ["status"]
    if a[0] == "start":
        cmd_start(a[1] if len(a) > 1 else "")
    elif a[0] == "end":
        cmd_end(closed="--closed" in a[1:])
    elif a[0] == "replay-keep":
        cmd_keep()
    elif a[0] == "saved":
        cmd_saved(a[1])
    elif a[0] == "settings":
        print(json.dumps(settings(a[1] if len(a) > 1 else "")))
    elif a[0] == "set" and len(a) == 4:
        cmd_set(a[1], a[2], a[3])
    elif a[0] == "budget":
        cmd_budget(a[1] if len(a) > 1 else None)
    elif a[0] == "cleanup":
        cmd_cleanup()
    elif a[0] == "library":
        cmd_library()
    elif a[0] == "thumbs":
        cmd_thumbs()
    elif a[0] == "rename" and len(a) == 3:
        cmd_rename(a[1], a[2])
    elif a[0] == "fav" and len(a) == 3:
        cmd_fav(a[1], a[2])
    elif a[0] == "clips":
        cmd_clips(a[1] if len(a) > 1 else "")
    elif a[0] == "recap":
        r = load(LAST, None)
        print(json.dumps(dict(r, text=recap_text(r))) if r else "{}")
    elif a[0] == "status":
        print(json.dumps(load(SESSION, {})))
    else:
        sys.exit("usage: torus-play start CLASS | end | saved PATH | settings [APPID] | set APPID KEY VALUE | clips [APPID] | library | fav PATH on|off|toggle | budget [GB] | cleanup | recap | status")


if __name__ == "__main__":
    main()
