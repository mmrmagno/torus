"$schema" = 'https://starship.rs/config-schema.json'
add_newline = false
palette = "catppuccin_@flavour@"
format = """\
[󰣇 ](mauve)\
$directory\
$git_branch$git_commit$git_state $git_status\
$character
"""
right_format = """$kubernetes$golang$python$nodejs$rust$deno$lua$terraform$docker_context$cmd_duration"""

[directory]
style = "bold lavender"
truncation_length = 4
truncate_to_repo = true
read_only = ""

[git_branch]
symbol = " "
style = "mauve"
format = "[$symbol$branch]($style)"

[git_status]
style = "peach"

[character]
success_symbol = "[❯](bold mauve)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold green)"

[cmd_duration]
style = "overlay1"
format = "[ $duration]($style)"

[kubernetes]
disabled = false
detect_files = ["kustomization.yaml", "Chart.yaml", "helmfile.yaml", "talconfig.yaml", "skaffold.yaml"]
detect_folders = ["k8s", "kubernetes", "manifests", "talos", "clusters"]
style = "sapphire"
format = "[󱃾 $context]($style) "

[golang]
style = "sapphire"
format = "[ $version]($style) "

[python]
style = "yellow"
format = "[ $version]($style) "

[nodejs]
style = "green"
format = "[ $version]($style) "

[rust]
style = "peach"
format = "[ $version]($style) "

[palettes.catppuccin_@flavour@]
rosewater = "@rosewater@"
flamingo = "@flamingo@"
pink = "@pink@"
mauve = "@mauve@"
red = "@red@"
maroon = "@maroon@"
peach = "@peach@"
yellow = "@yellow@"
green = "@green@"
teal = "@teal@"
sky = "@sky@"
sapphire = "@sapphire@"
blue = "@blue@"
lavender = "@lavender@"
text = "@text@"
subtext1 = "@subtext1@"
subtext0 = "@subtext0@"
overlay2 = "@overlay2@"
overlay1 = "@overlay1@"
overlay0 = "@overlay0@"
surface2 = "@surface2@"
surface1 = "@surface1@"
surface0 = "@surface0@"
base = "@base@"
mantle = "@mantle@"
crust = "@crust@"
