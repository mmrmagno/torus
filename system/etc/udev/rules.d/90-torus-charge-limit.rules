# torus: let the wheel group switch the battery charge limit (charge_control_end_threshold, charge_types or ideapad conservation_mode)
SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/bin/sh -c 'for f in /sys%p/charge_control_end_threshold /sys%p/charge_types; do [ -e $$f ] && chgrp wheel $$f && chmod g+w $$f; done; true'"
SUBSYSTEM=="platform", DRIVER=="ideapad_acpi", RUN+="/bin/sh -c 'f=/sys%p/conservation_mode; [ -e $$f ] && chgrp wheel $$f && chmod g+w $$f; true'"
